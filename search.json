---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %d, %Y" | jsonify }},
    "category": {{ post.categories.first | default: "General" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 250 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
